  <!-- Modal control script -->
  <script>
    const openReflection = document.getElementById('openReflection');
    const closeReflection = document.getElementById('closeReflection');
    const reflectionModal = document.getElementById('reflectionModal');

    openReflection.onclick = function() {
      reflectionModal.style.display = "block";
    }

    closeReflection.onclick = function() {
      reflectionModal.style.display = "none";
    }

    window.onclick = function(event) {
      if (event.target == reflectionModal) {
        reflectionModal.style.display = "none";
      }
    }
  </script>

